# Prodigi API key. Get one at https://dashboard.prodigi.com/
# Sandbox and Live keys are different.
PRODIGI_API_KEY=

# "sandbox" (default) -> https://api.sandbox.prodigi.com
# "live"                -> https://api.prodigi.com
PRODIGI_ENVIRONMENT=sandbox

# Optional request timeout in milliseconds (default 60000)
PRODIGI_TIMEOUT_MS=60000
